<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CVExpress.Views.ApercuPage"
             Title="Aperçu"
             BackgroundColor="#F5F6F8">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="12">

        <HorizontalStackLayout Spacing="14">
            <Label Text="←" FontSize="26" TextColor="Gray"
             VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RetourCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Aperçu" FontSize="24" FontAttributes="Bold"
             TextColor="Black" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <Border BackgroundColor="White" Stroke="#E5E7EB" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="6">

                    <Label Text="{Binding NomComplet}" FontSize="24"
                 FontAttributes="Bold" TextColor="{Binding Accent}"/>
                    <Label Text="{Binding Profession}" FontSize="15"
                 FontAttributes="Bold" TextColor="Black"/>
                    <Label Text="{Binding Contact}" FontSize="12" TextColor="Gray"/>

                    <Label Text="À propos" FontSize="16" FontAttributes="Bold"
                 TextColor="{Binding Accent}" Margin="0,14,0,0"/>
                    <Label Text="{Binding APropos}" TextColor="Black"/>

                    <Label Text="Expérience" FontSize="16" FontAttributes="Bold"
                 TextColor="{Binding Accent}" Margin="0,14,0,0"/>
                    <VerticalStackLayout Spacing="8"
              BindableLayout.ItemsSource="{Binding Experiences}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Poste}" FontAttributes="Bold"
                         TextColor="Black"/>
                                    <Label Text="{Binding Entreprise}" TextColor="Gray"/>
                                    <Label Text="{Binding Periode}" TextColor="Gray"
                         FontSize="12"/>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="Formation" FontSize="16" FontAttributes="Bold"
                 TextColor="{Binding Accent}" Margin="0,14,0,0"/>
                    <Label Text="{Binding Formation}" TextColor="Black"/>

                    <Label Text="Compétences" FontSize="16" FontAttributes="Bold"
                 TextColor="{Binding Accent}" Margin="0,14,0,0"/>
                    <Label Text="{Binding Competences}" TextColor="Black"/>

                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="Modifier" BackgroundColor="White"
              TextColor="{StaticResource Primary}"
              BorderColor="{StaticResource Primary}" BorderWidth="1"
              CornerRadius="14" HeightRequest="52"
              Command="{Binding ModifierCommand}"/>
            <Button Grid.Column="1" Text="Exporter en PDF"
              BackgroundColor="{StaticResource Primary}"
              TextColor="White" CornerRadius="14" HeightRequest="52"
              Command="{Binding ExporterCommand}"/>
        </Grid>

    </Grid>
</ContentPage>