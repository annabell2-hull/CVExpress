<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CVExpress.Views.InfosPersonnellesPage"
             Title="Informations personnelles"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24" RowSpacing="12">

        <HorizontalStackLayout Spacing="14">
            <Label Text="←" FontSize="26" TextColor="Gray"
             VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RetourCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Informations personnelles" FontSize="20"
             FontAttributes="Bold" TextColor="Black"
             VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="6">

                <Label Text="Prénom" FontAttributes="Bold" TextColor="Black"/>
                <Entry Text="{Binding Prenom}"/>

                <Label Text="Nom" FontAttributes="Bold" TextColor="Black"/>
                <Entry Text="{Binding Nom}"/>

                <Label Text="Profession" FontAttributes="Bold" TextColor="Black"/>
                <Entry Text="{Binding Profession}"
               Placeholder="Ex : Développeur mobile"/>

                <Label Text="Téléphone" FontAttributes="Bold" TextColor="Black"/>
                <Entry Text="{Binding Telephone}" Keyboard="Telephone"/>

                <Label Text="E-mail" FontAttributes="Bold" TextColor="Black"/>
                <Entry Text="{Binding Email}" Keyboard="Email"/>

                <Label Text="Ville" FontAttributes="Bold" TextColor="Black"/>
                <Entry Text="{Binding Ville}"/>

                <Label Text="À propos de moi" FontAttributes="Bold"
               TextColor="Gray"/>
                <Editor Text="{Binding APropos}" HeightRequest="130"
                Placeholder="Présente-toi en quelques lignes"/>
                <Label Text="Formation" FontAttributes="Bold" TextColor="Black"/>
                <Editor Text="{Binding Formation}" HeightRequest="100"
                Placeholder="Ex : Licence en informatique, 2022 - 2025"/>

                <Label Text="Compétences" FontAttributes="Bold" TextColor="Black"/>
                <Editor Text="{Binding Competences}" HeightRequest="100"
                Placeholder="Ex : C#, .NET MAUI, SQL"/>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8">
            <Label Text="{Binding Erreur}" TextColor="Red"
             IsVisible="{Binding ErreurVisible}"/>
            <Button Text="CONTINUER"
              BackgroundColor="{StaticResource Primary}"
              TextColor="White" CornerRadius="14" HeightRequest="52"
              Command="{Binding ContinuerCommand}"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>