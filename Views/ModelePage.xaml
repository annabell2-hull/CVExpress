<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CVExpress.Views.ModelePage"
             Title="Choisir ton modèle"
             BackgroundColor="White">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24" RowSpacing="16">

        <HorizontalStackLayout Spacing="14">
            <Label Text="←" FontSize="26" TextColor="Gray"
             VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RetourCommand}"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Choisir ton modèle" FontSize="20"
             FontAttributes="Bold" TextColor="Black"
             VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="10"
          VerticalOptions="Start">

            <Border Stroke="{Binding BordureClassique}" StrokeThickness="2"
              BackgroundColor="#F3F4F6" Padding="10" HeightRequest="190">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChoisirCommand}"
                                CommandParameter="Classique"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Classique" FontAttributes="Bold"
                 TextColor="Black" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="2" Color="Gray"/>
                    <BoxView HeightRequest="2" Color="Gray"/>
                    <BoxView HeightRequest="2" Color="Gray"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Stroke="{Binding BordureModerne}"
              StrokeThickness="2" BackgroundColor="#F3F4F6"
              Padding="10" HeightRequest="190">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChoisirCommand}"
                                CommandParameter="Moderne"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Moderne" FontAttributes="Bold"
                 TextColor="Black" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="8"
                   Color="{StaticResource Primary}"/>
                    <BoxView HeightRequest="2" Color="Gray"/>
                    <BoxView HeightRequest="2" Color="Gray"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="2" Stroke="{Binding BordureSobre}"
              StrokeThickness="2" BackgroundColor="#F3F4F6"
              Padding="10" HeightRequest="190">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChoisirCommand}"
                                CommandParameter="Sobre"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Sobre" FontAttributes="Bold"
                 TextColor="Black" HorizontalOptions="Center"/>
                    <BoxView HeightRequest="2" Color="LightGray"/>
                    <BoxView HeightRequest="2" Color="LightGray"/>
                    <BoxView HeightRequest="2" Color="LightGray"/>
                </VerticalStackLayout>
            </Border>

        </Grid>

        <Button Grid.Row="2" Text="Aperçu"
            BackgroundColor="{StaticResource Primary}"
            TextColor="White" CornerRadius="14" HeightRequest="52"
            Command="{Binding ApercuCommand}"/>

    </Grid>
</ContentPage>