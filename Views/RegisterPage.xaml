<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CVExpress.Views.RegisterPage"
             Title="Créer un compte"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="10">

            <Label Text="Créer un compte" FontSize="28"
             FontAttributes="Bold" TextColor="Black"/>
            <Label Text="Quelques informations suffisent pour commencer"
             TextColor="Gray" Margin="0,0,0,12"/>

            <Label Text="Prénom" FontAttributes="Bold" TextColor="Black"/>
            <Entry Text="{Binding Prenom}"/>

            <Label Text="Nom" FontAttributes="Bold" TextColor="Black"/>
            <Entry Text="{Binding Nom}"/>

            <Label Text="Adresse e-mail" FontAttributes="Bold"
             TextColor="Black"/>
            <Entry Text="{Binding Email}" Keyboard="Email"/>

            <Label Text="Mot de passe" FontAttributes="Bold"
             TextColor="Black"/>
            <Entry Text="{Binding MotDePasse}" IsPassword="True"/>
            <Label Text="8 caractères minimum" FontSize="12"
             TextColor="Gray"/>

            <Label Text="Confirmer le mot de passe" FontAttributes="Bold"
             TextColor="Black"/>
            <Entry Text="{Binding Confirmation}" IsPassword="True"/>

            <Label Text="{Binding Erreur}" TextColor="Red"
             IsVisible="{Binding ErreurVisible}"/>

            <Button Text="Créer un compte" Margin="0,16,0,0"
              BackgroundColor="{StaticResource Primary}"
              TextColor="White" CornerRadius="14"
              HeightRequest="52"
              Command="{Binding InscrireCommand}"/>

            <Label Text="Se connecter" HorizontalOptions="Center"
             TextColor="{StaticResource Primary}" Margin="0,8,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding RetourCommand}"/>
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>